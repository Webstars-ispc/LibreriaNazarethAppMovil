<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloUsuarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuarios"
                android:textColor="@color/texto_titulo"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Búsqueda -->
            <LinearLayout
                android:id="@+id/llBusquedaUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:background="@color/fondo_card"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Buscar usuario"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/dorado_claro" />

                <EditText
                    android:id="@+id/etBuscarUsuario"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="Buscar por nombre..."
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_principal"
                    android:background="@null"
                    android:inputType="text" />

            </LinearLayout>

            <!-- Usuario 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardUsuario1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/fondo_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNombreUsuario1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Baltazar Ledesma"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorreoUsuario1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="baltazar@email.com"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRolUsuario1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Rol: Cliente"
                        android:textColor="@color/dorado_claro"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEditarUsuario1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EDITAR"
                            android:textColor="@color/dorado_claro"
                            android:backgroundTint="@color/borde"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnEliminarUsuario1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ELIMINAR"
                            android:textColor="@color/dorado_claro"
                            android:backgroundTint="@color/borde"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Usuario 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardUsuario2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/fondo_card">

                <LinearLayout
                    android:id="@+id/llListaUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNombreUsuario2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Salvador Ledesma"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorreoUsuario2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="salvador@email.com"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRolUsuario2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Rol: Cliente"
                        android:textColor="@color/dorado_claro"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEditarUsuario2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EDITAR"
                            android:textColor="@color/dorado_claro"
                            android:backgroundTint="@color/borde"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnEliminarUsuario2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ELIMINAR"
                            android:textColor="@color/dorado_claro"
                            android:backgroundTint="@color/borde"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Espacio inferior -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Botón agregar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Agregar usuario"
        app:backgroundTint="@color/dorado"
        app:tint="@color/boton_texto"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Menú inferior -->
    <include
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>