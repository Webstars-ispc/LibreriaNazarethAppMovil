<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_producto_titulo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/texto_titulo"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etNombre"
                android:text="@string/campo_nombre"
                android:textSize="14sp"
                android:textColor="@color/texto_hint"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_nombre_hint"
                android:inputType="text"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_hint"
                android:background="@drawable/input_fondo"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etDescripcion"
                android:text="@string/campo_descripcion"
                android:textSize="14sp"
                android:textColor="@color/texto_hint"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_descripcion_hint"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_hint"
                android:background="@drawable/input_fondo"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etCodigoBarras"
                android:text="@string/campo_codigo_barras"
                android:textSize="14sp"
                android:textColor="@color/texto_hint"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etCodigoBarras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/campo_codigo_barras"
                    android:inputType="number"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_hint"
                    android:background="@drawable/input_fondo"
                    android:padding="12dp" />

                <ImageView
                    android:id="@+id/ivEscanearCodigoProducto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/escanear_codigo_barras"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/dorado_claro" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinnerRubro"
                android:text="@string/campo_rubro"
                android:textSize="14sp"
                android:textColor="@color/texto_hint"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerRubro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinnerMarca"
                android:text="@string/campo_marca"
                android:textSize="14sp"
                android:textColor="@color/texto_hint"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerMarca"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/etPrecioCosto"
                        android:text="@string/campo_precio_costo"
                        android:textSize="14sp"
                        android:textColor="@color/texto_hint"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etPrecioCosto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/precio_hint"
                        android:inputType="numberDecimal"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_hint"
                        android:background="@drawable/input_fondo"
                        android:padding="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/etPrecioVenta"
                        android:text="@string/campo_precio_venta"
                        android:textSize="14sp"
                        android:textColor="@color/texto_hint"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etPrecioVenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/precio_hint"
                        android:inputType="numberDecimal"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_hint"
                        android:background="@drawable/input_fondo"
                        android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etStock"
                android:text="@string/campo_stock"
                android:textSize="14sp"
                android:textColor="@color/texto_hint"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_stock_hint"
                android:inputType="number"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_hint"
                android:background="@drawable/input_fondo"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cancelar"
                    android:textColor="@color/texto_principal"
                    android:backgroundTint="@color/borde"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/guardar"
                    android:textColor="@color/boton_texto"
                    android:backgroundTint="@color/dorado"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Menú inferior -->
    <include
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>