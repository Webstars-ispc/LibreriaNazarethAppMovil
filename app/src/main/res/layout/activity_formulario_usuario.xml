<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar usuario"
                android:textColor="@color/texto_titulo"
                android:textSize="26sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:hint="Nombre completo"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_hint" />

            <EditText
                android:id="@+id/etCorreoUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_hint" />

            <EditText
                android:id="@+id/etContrasenaUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_hint" />

            <Spinner
                android:id="@+id/spinnerRolUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnGuardarUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:text="GUARDAR USUARIO"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/boton_texto"
                android:backgroundTint="@color/dorado" />

            <Button
                android:id="@+id/btnCancelarUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:text="CANCELAR"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dorado_claro"
                android:backgroundTint="@color/borde" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>